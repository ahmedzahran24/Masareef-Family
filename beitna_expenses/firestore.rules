rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function owner(hid) {
      return member(hid) && get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'owner';
    }
    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['householdId','creator','createdAt'])
        && request.resource.data.creator == request.auth.uid
        && member(request.resource.data.householdId)
        && owner(request.resource.data.householdId);
      allow update: if false;
      allow delete: if signedIn() && owner(resource.data.householdId);
    }
    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.resource.data.name is string && request.resource.data.budget is number;
      allow read: if member(hid);
      allow update: if member(hid) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['budget','name'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.budget is number && request.resource.data.name is string;
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(hid);
        allow create: if signedIn() && request.auth.uid == uid && (
          (get(/databases/$(database)/documents/households/$(hid)).data.owner == uid && request.resource.data.role == 'owner') ||
          (request.resource.data.role == 'member' && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid)
        );
        allow update, delete: if false;
      }
      match /entries/{eid} {
        allow read: if member(hid);
        allow create: if member(hid) && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.type in ['expense','income']
          && request.resource.data.category is string
          && request.resource.data.note is string
          && request.resource.data.createdAt is timestamp;
        allow update: if member(hid) && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.type in ['expense','income'];
        allow delete: if member(hid) && resource.data.createdBy == request.auth.uid;
      }
    }
  }
}
