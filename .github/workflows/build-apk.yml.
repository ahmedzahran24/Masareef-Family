name: Build Beitna APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Generate Android project
        working-directory: beitna_expenses
        run: |
          flutter create --platforms=android --project-name beitna_expenses .
          flutter pub get

      - name: Build APK
        working-directory: beitna_expenses
        run: flutter build apk --debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Beitna-Android-APK
          path: beitna_expenses/build/app/outputs/flutter-apk/app-debug.apk
          if-no-files-found: error
